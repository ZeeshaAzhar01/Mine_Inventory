# ==============================================================================
# MINING INVENTORY API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=3000

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mining_inventory_db"

# JWT Authentication Secret Key & Expiration
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_EXPIRES_IN=1d

# Allowed CORS Origins (comma-separated for multiple, or '*' for development/wildcard)
# Example: https://mining-inventory.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Logging Level ('error' | 'warn' | 'info' | 'http' | 'debug')
LOG_LEVEL=info
