generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENGINEER
}

model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  password_hash String
  role          Role   @default(ENGINEER)
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  gst_number   String   @unique
  contact_info String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}